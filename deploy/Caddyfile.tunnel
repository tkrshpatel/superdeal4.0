{
	admin off
	auto_https off
	servers {
		# Only the local cloudflared connector reaches this loopback listener.
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
		timeouts {
			read_header 10s
			read_body 10s
			idle 30s
		}
	}
}
# HTTPS terminates at Cloudflare; this HTTP origin is never bound to the LAN.
:{$SUPERDEAL_FRONTEND_PORT:8080} {
	bind 127.0.0.1
	import common.caddy
}
