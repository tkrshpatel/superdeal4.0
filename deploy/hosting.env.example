# Merge these into your existing root .env. Preserve your API/Mongo settings.
# GoDaddy can remain the registrar; the tunnel option uses Cloudflare DNS.
SUPERDEAL_DOMAIN=your-domain.example
SUPERDEAL_PUBLIC_URL=https://your-domain.example
SUPERDEAL_ALERT_ORIGINS=https://your-domain.example
SUPERDEAL_PRODUCTION=1
# Generate a unique value locally: python -c "import secrets; print(secrets.token_hex(32))"
# This must be different from SUPERDEAL_ADMIN_TOKEN.
SUPERDEAL_PROXY_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SUPERDEAL_FRONTEND_PORT=8080
# Opt-in scheduled delivery; disabled until Gmail SMTP is configured.
SUPERDEAL_NOTIFICATIONS_ENABLED=0
# SUPERDEAL_EMAIL_MODE=smtp
# SUPERDEAL_EMAIL_FROM=SuperDeals <superdeals.helpdesk@gmail.com>
# SUPERDEAL_SMTP_HOST=smtp.gmail.com
# SUPERDEAL_SMTP_PORT=587
# SUPERDEAL_SMTP_USER=superdeals.helpdesk@gmail.com
# SUPERDEAL_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
